<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Retrograde</AssemblyName>
    <!-- Shown in the title bar. -->
    <Version>2.2.0</Version>
    <Product>Retrograde</Product>
    <AssemblyTitle>Retrograde</AssemblyTitle>
    <RootNamespace>Retrograde.App</RootNamespace>
  </PropertyGroup>

  <!-- Release publish (linux-x64): Native AOT (needs clang and lld). No JIT, ~44 MB, ~30 MB less PSS than trimmed JIT. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <!-- Measured after scanning a library: ~30 MB less PSS than the defaults -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- NuGet native packages ship ~100MB of .pdb symbols (SkiaSharp, HarfBuzz); keep them out of the publish. -->
  <Target Name="StripPublishedPdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- TagLib# finds its file types by reflection; keep the whole assembly when trimming. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Retrograde.Core\Retrograde.Core.csproj" />
    <ProjectReference Include="..\Retrograde.Audio\Retrograde.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <!-- PRIVATE_MEMORY_BANK picture -->
    <AvaloniaResource Include="..\..\assets\kristen.png" Link="Assets\kristen.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Native Wayland backend (experimental in Avalonia 12.1), opt-in with RETRO_BACKEND=wayland, see Program.cs -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.5" />
  </ItemGroup>
</Project>
